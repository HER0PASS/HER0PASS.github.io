RewriteEngine On
RewriteBase /

# Redirigir /analytics/streams a /analytics/streams.php
RewriteRule ^analytics/streams/?$ analytics/streams.php [L]

# Redirigir /analytics/user?id=X a /analytics/user.php (manteniendo los parámetros)
RewriteRule ^analytics/user/?$ analytics/user.php [QSA,L]

# Redirigir /analytics/streams/enriched?limit=X a /analytics/streams/enriched.php
RewriteRule ^analytics/streams/enriched/?$ analytics/streams/enriched.php [QSA,L]
